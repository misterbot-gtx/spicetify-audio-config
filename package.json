{
  "name": "audio_config",
  "version": "1.0.0",
  "description": "Extensão Spicetify para trocar a saída de áudio do Spotify sem sair do player",
  "main": "src/app.tsx",
  "scripts": {
    "build": "spicetify-creator --minify --out=dist",
    "watch": "spicetify-creator --watch --out=dist",
    "install-local": "node scripts/install-local.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "spicetify",
    "spotify",
    "audio"
  ],
  "author": "misterbot-gtx",
  "license": "ISC",
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "spicetify-creator": "^1.0.17",
    "typescript": "^5.4.0"
  }
}
