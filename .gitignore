# Dependências
node_modules/

# Builds / arquivos gerados
# ATENCAO: dist/ NAO pode ser ignorado. O Marketplace do Spicetify baixa o
# bundle direto do repositorio (manifest.json -> "main": "dist/audio-config.js"),
# entao ele precisa estar versionado. Ignorar esta pasta publica uma extensao
# quebrada.
dist/
!dist/audio-config.js

# Arquivos de ambiente
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache
.cache/
.parcel-cache/
.vite/
.turbo/

# TypeScript
*.tsbuildinfo

# Sistema operacional
.DS_Store
Thumbs.db
desktop.ini

# IDE / editores
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Arquivos temporários
*.tmp
*.temp
*.swp
*.swo

# Cobertura de testes
coverage/

# Testes / relatórios gerados
.nyc_output/

